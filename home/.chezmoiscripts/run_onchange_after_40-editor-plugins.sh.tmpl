{{ if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Re-runs when the plugin lists change.
# nvim lazy-lock: {{ include (joinPath .chezmoi.workingTree "nvim/lazy-lock.json") | sha256sum }}
# tmux.conf:      {{ include "dot_tmux.conf" | sha256sum }}
set -uo pipefail

if [ -x "$HOME/.tmux/plugins/tpm/bin/install_plugins" ] && command -v tmux >/dev/null 2>&1; then
  echo "==> Installing tmux plugins"
  "$HOME/.tmux/plugins/tpm/bin/install_plugins" >/dev/null || echo "WARN: tmux plugin install failed (prefix + I inside tmux)"
fi

if command -v nvim >/dev/null 2>&1; then
  echo "==> Syncing Neovim plugins to lazy-lock.json"
  nvim --headless "+Lazy! restore" +qa >/dev/null 2>&1 || echo "WARN: nvim plugin restore failed (run :Lazy restore)"
fi
{{ end -}}
