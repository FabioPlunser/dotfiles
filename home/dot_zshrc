# ~/.zshrc for macOS, Linux and WSL2. Managed by chezmoi from ~/dotfiles/home/dot_zshrc.
# Machine-specific stuff goes in ~/.zshrc.local (not tracked).

# SSH agent: keychain asks for the key passphrase once per boot.
# Must run before the p10k instant prompt because it may ask for input.
if command -v keychain >/dev/null 2>&1 && [[ -f "$HOME/.ssh/id_ed25519" ]]; then
  eval "$(keychain --eval --quiet id_ed25519)"
fi

# Powerlevel10k instant prompt. Keep close to the top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

source "$HOME/.config/shell/common.sh"

# ------------------------------------------------------------- oh-my-zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(
  git
  zsh-vi-mode
  fzf
  zsh-autosuggestions
  zsh-syntax-highlighting
)
source "$ZSH/oh-my-zsh.sh"

[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# ----------------------------------------------------------------- tools ---
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# ------------------------------------------------------------- widgets ---
# Ctrl-h: fuzzy-search history and execute the selection
fzf_history_execute_widget() {
  local original_buffer=$BUFFER
  local original_cursor=$CURSOR
  local selected_command
  selected_command=$(fc -l -n 1 | fzf --height 40% --border --tac --prompt="Execute History: " --query="$LBUFFER")

  if [[ -n "$selected_command" ]]; then
    BUFFER="$selected_command"
    CURSOR=${#BUFFER}
    zle accept-line
  else
    BUFFER=$original_buffer
    CURSOR=$original_cursor
    zle send-invisible
  fi
  zle redisplay
}
zle -N fzf_history_execute_widget
bindkey '^h' fzf_history_execute_widget

# Ctrl-f: fuzzy-find a directory under FZF_FIND_DIRS and cd into it.
# Override FZF_FIND_DIRS in ~/.zshrc.local per machine.
(( ${+FZF_FIND_DIRS} )) || FZF_FIND_DIRS=(~/Nextcloud/Uni/8.Semester)
fzf-find-widget() {
  local selected
  selected=$(
    for dir in "${FZF_FIND_DIRS[@]}"; do
      find "$dir" -maxdepth 4 -type d 2>/dev/null
    done | fzf \
      --preview 'ls -lh {}' \
      --preview-window 'right:45%' \
      --header '📁 Find Directory (C-f)' \
      --margin 1 \
      --padding 1 \
      --color 'header:bold:blue' \
      --info inline \
      --pointer '▶' \
      --marker '✓'
  )

  if [[ -n $selected ]]; then
    cd "$selected"
    zle reset-prompt
  fi
}
zle -N fzf-find-widget
bindkey '^f' fzf-find-widget

# ---------------------------------------------------------------- local ---
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
