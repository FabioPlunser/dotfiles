<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>io.glzr.zebar-wake</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/opt/sleepwatcher/sbin/sleepwatcher</string>
		<string>-w</string>
		<string>{{ .chezmoi.homeDir }}/.glzr/zebar/bin/on-wake.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
